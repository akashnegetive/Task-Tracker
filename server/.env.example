# PostgreSQL connection string
DATABASE_URL="postgresql://tasktracker:tasktracker@localhost:5432/tasktracker?schema=public"

# JWT signing secret (use a long random value in production)
JWT_SECRET="dev-secret-change-me"

# Access token lifetime
JWT_EXPIRES_IN="7d"

# API port
PORT=4000

# Allowed browser origin for CORS (the frontend URL)
CLIENT_ORIGIN="http://localhost:5173"

# "production" enables Secure cookies
NODE_ENV="development"
